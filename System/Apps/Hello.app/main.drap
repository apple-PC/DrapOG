// Hello —— DrapLang CLI 示例应用
// 演示：term_print 打印字符串与整数、表达式计算、字符串拼接、数组长度

fn square(n: i32) -> i32 {
    return n * n
}

entry fn main() -> i32 {
    term_print("=== DrapLang CLI 示例：Hello ===\n")
    term_print("你好，DrapOG！\n")
    term_print("\n")

    term_print("=== 计算 ===\n")
    let s = square(7)
    term_print("7 的平方 = ")
    term_print(s)
    term_print("\n")
    term_print("3 + 4 * 2 = ")
    term_print(3 + 4 * 2)
    term_print("\n")
    term_print("\n")

    term_print("=== 字符串 ===\n")
    let name = "梓涵"
    term_print("问候：你好，" + name + "！\n")
    term_print("\n")

    term_print("=== 数组 ===\n")
    let nums = [1, 2, 3, 4, 5]
    term_print("数组长度 = ")
    term_print(nums.len)
    term_print("\n")
    term_print("最后一个元素 = ")
    term_print(nums[4])
    term_print("\n")

    return 0
}

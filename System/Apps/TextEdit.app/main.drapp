// TextEdit —— 简易文本编辑器（DrapLang 自举版，L9·D 阶段示范）
// 自动加载 /Users/guest/Documents/readme.txt；工具栏 新建 / 打开 / 保存；路径栏（win_input 可编辑）；
// 文本区光标固定在文末，支持回车换行与退格。模型：main 初始化共享状态；on_paint 自绘；on_key / on_click 处理。
import str

entry fn main() -> i32 {
    let win = syscall win_create("TextEdit", 560, 420)
    syscall win_mono(1)
    syscall win_set_font(14)
    let text = ""
    let path = "/Users/guest/Documents/readme.txt"
    syscall win_set_input("path", path)
    let status = ""
    let loaded = 0
    let W = 0
    let H = 0
    let top = 64
    let lh = 18
    let pad = 10
    let i = 0
    let total = 0
    let start = 0
    let vis = 0
    let lines = [""]
    let ln = 0
    let lastLine = ""
    let cx = 0
    let cy = 0
    let content = 0
    let eff = ""
    let id = ""
    let c = ""
    let x = 0
    let y = 0
    let name = ""
    let target = ""
    let base = ""
    let found = -1
    // 文件选择器（模态）：0 关闭 / 1 打开 / 2 保存
    let picker = 0
    let pDir = "/Users/guest/Documents"
    let pItems = [""]
    let pIsDir = [0]
    let pSel = -1
    let pX = [0]
    let pY = [0]
    let pW = [0]
    let pH = [0]
    let pCount = 0
    let pName = ""
}

event fn on_paint() {
    W = syscall win_w()
    H = syscall win_h()
    syscall win_theme(0)
    syscall win_fill_rect(0, 0, W, H)
    // 工具栏
    syscall win_theme(3)
    syscall win_fill_rect(0, 0, W, 34)
    syscall win_button("docNew", 8, 4, 48, 26)
    syscall win_button("docOpen", 64, 4, 48, 26)
    syscall win_button("docSave", 120, 4, 48, 26)
    // 路径栏
    syscall win_theme(3)
    syscall win_fill_rect(0, 34, W, 26)
    syscall win_input("path", 8, 38, W - 16, 18)
    eff = syscall win_input_get("path")
    syscall win_theme(1)
    syscall win_set_font(12)
    syscall win_text(8, 41, eff)
    // 首次加载 readme.txt
    if (loaded == 0) {
        loaded = 1
        content = syscall fs_read(path)
        if (content != 0) { text = content }
        syscall win_invalidate(win)
    }
    // 文本区
    lines = split(text, "\n")
    total = len(lines)
    vis = (H - top - 22) / lh
    start = 0
    if (total > vis) { start = total - vis }
    i = 0
    while (i < vis) {
        ln = start + i
        if (ln < total) {
            syscall win_theme(1)
            syscall win_set_font(14)
            syscall win_text(pad, top + i * lh, lines[ln])
        }
        i = i + 1
    }
    // 文末光标
    lastLine = lines[total - 1]
    cx = pad + len(lastLine) * 8
    cy = top + (total - 1 - start) * lh
    if (cy < H - 22) {
        syscall win_theme(2)
        syscall win_fill_rect(cx, cy, 2, 16)
    }
    // 状态栏
    syscall win_theme(3)
    syscall win_fill_rect(0, H - 22, W, 22)
    syscall win_theme(1)
    syscall win_set_font(11)
    syscall win_text(8, H - 18, status + "  " + itoa(len(text)) + " 字符")

    // ===== 文件选择器（模态）=====
    if (picker != 0) {
        syscall win_set_color(0, 0, 0)
        syscall win_fill_rect(0, 0, W, H)
        let pw = 460
        let ph = 320
        let px = (W - pw) / 2
        let py = (H - ph) / 2
        syscall win_set_color(40, 40, 46)
        syscall win_fill_rect(px, py, pw, ph)
        syscall win_theme(1)
        syscall win_set_font(15)
        if (picker == 1) { syscall win_text(px + 16, py + 16, "打开文件") } else { syscall win_text(px + 16, py + 16, "保存文件") }
        syscall win_set_font(11)
        syscall win_set_color(150, 150, 160)
        syscall win_text(px + 16, py + 42, pDir)
        syscall win_button("pUp", px + pw - 92, py + 34, 76, 24)
        let lsr = syscall fs_ls(pDir)
        let raw = [""]
        if (lsr != 0) { raw = split(lsr, "\n") } else { raw = [] }
        pItems = []
        pIsDir = []
        i = 0
        while (i < len(raw)) {
            if (len(raw[i]) > 0) {
                pItems.push(raw[i])
                if (substr(raw[i], len(raw[i]) - 1, 1) == "/") { pIsDir.push(1) } else { pIsDir.push(0) }
            }
            i = i + 1
        }
        pCount = len(pItems)
        pX = []; pY = []; pW = []; pH = []
        let lx0 = px + 12
        let ly0 = py + 70
        let rh = 28
        i = 0
        while (i < pCount) {
            pX.push(lx0); pY.push(ly0 + i * rh); pW.push(pw - 24); pH.push(rh)
            if (i == pSel) { syscall win_theme(4); syscall win_fill_rect(lx0, ly0 + i * rh, pw - 24, rh) }
            let nm = pItems[i]
            let isd = pIsDir[i]
            let gname = "file"
            if (isd == 1 && len(nm) >= 4 && substr(nm, len(nm) - 4, 4) == ".app") { gname = "app" }
            else if (isd == 1) { gname = "folder" }
            syscall win_glyph(gname, lx0 + 4, ly0 + i * rh + 4, 20)
            syscall win_theme(1)
            syscall win_set_font(13)
            let disp = nm
            if (isd == 1) { disp = substr(nm, 0, len(nm) - 1) }
            syscall win_text(lx0 + 30, ly0 + i * rh + 7, disp)
            i = i + 1
        }
        if (picker == 1) {
            syscall win_button("pOpen", px + pw - 168, py + ph - 38, 76, 28)
            syscall win_button("pCancel", px + pw - 84, py + ph - 38, 72, 28)
        } else {
            syscall win_input("pName", px + 16, py + ph - 40, pw - 200, 26)
            syscall win_button("pSave", px + pw - 168, py + ph - 38, 76, 28)
            syscall win_button("pCancel", px + pw - 84, py + ph - 38, 72, 28)
        }
    }
    return 0
}

event fn on_key(ev: str) {
    if (picker != 0) {
        if (ev == "key Escape") { picker = 0 }
        syscall win_invalidate(win); return 0
    }
    if (ev == "key ") { c = " " }
    else { c = substr(ev, 4) }
    if (c == "Enter") { text = text + "\n"; status = "" }
    else if (c == "Backspace") {
        if (len(text) > 0) { text = substr(text, 0, len(text) - 1); status = "" }
    }
    else if (len(c) == 1) { text = text + c; status = "" }
    syscall win_invalidate(win)
    return 0
}

event fn on_click(ev: str) {
    let parts2 = split(ev, " ")
    if (len(parts2) >= 2) { id = parts2[1] } else { id = "" }
    if (len(parts2) >= 3) { x = atoi(parts2[1]); y = atoi(parts2[2]) } else { x = -1; y = -1 }
    // 文件选择器优先处理（模态期间拦截一切编辑操作）
    if (picker != 0) {
        if (id == "pUp") { pDir = syscall fs_realpath(pDir, ".."); pSel = -1 }
        else if (id == "pCancel") { picker = 0 }
        else if (id == "pOpen") {
            if (pSel >= 0 && pSel < pCount && pIsDir[pSel] == 0) {
                target = syscall fs_realpath(pDir, pItems[pSel])
                content = syscall fs_read(target)
                if (content != 0) { text = content; status = "已打开 " + target; path = target; syscall win_set_input("path", target) }
            }
            picker = 0
        } else if (id == "pSave") {
            name = syscall win_input_get("pName")
            if (len(name) > 0) {
                target = syscall fs_realpath(pDir, name)
                syscall fs_write(target, text)
                path = target; status = "已保存 " + target; syscall win_set_input("path", target)
            }
            picker = 0
        } else if (id == "pName") {
            // 输入框聚焦，无需处理
        } else {
            if (len(parts2) >= 3) {
                i = 0; found = -1
                while (i < pCount) {
                    if (x >= pX[i] && x <= pX[i] + pW[i] && y >= pY[i] && y <= pY[i] + pH[i]) { found = i }
                    i = i + 1
                }
                if (found >= 0) {
                    pSel = found
                    if (pIsDir[found] == 1) {
                        name = pItems[found]
                        pDir = syscall fs_realpath(pDir, substr(name, 0, len(name) - 1))
                        pSel = -1
                    }
                }
            }
        }
        syscall win_invalidate(win); return 0
    }
    if (id == "docNew") { text = ""; status = "已新建" }
    else if (id == "docOpen") {
        // 打开文件选择器
        if (len(path) > 0 && contains(path, "/")) {
            base = path; found = len(base)
            while (found > 0 && substr(base, found - 1, 1) != "/") { found = found - 1 }
            pDir = substr(base, 0, found)
            if (len(pDir) > 0 && substr(pDir, len(pDir) - 1, 1) == "/") { pDir = substr(pDir, 0, len(pDir) - 1) }
            if (len(pDir) == 0) { pDir = "/" }
        } else { pDir = "/Users/guest/Documents" }
        pSel = -1; picker = 1
        syscall win_invalidate(win)
    }
    else if (id == "docSave") {
        eff = syscall win_input_get("path")
        if (eff == "") { eff = path }
        if (syscall fs_exists(eff) == 1) {
            syscall fs_write(eff, text); path = eff; status = "已保存 " + eff; syscall win_set_input("path", eff)
        } else {
            if (len(eff) > 0 && contains(eff, "/")) {
                base = eff; found = len(base)
                while (found > 0 && substr(base, found - 1, 1) != "/") { found = found - 1 }
                pDir = substr(base, 0, found)
                if (len(pDir) > 0 && substr(pDir, len(pDir) - 1, 1) == "/") { pDir = substr(pDir, 0, len(pDir) - 1) }
                if (len(pDir) == 0) { pDir = "/" }
                pName = substr(base, found)
            } else { pDir = "/Users/guest/Documents"; pName = "未命名.txt" }
            syscall win_set_input("pName", pName)
            pSel = -1; picker = 2
        }
        syscall win_invalidate(win)
    }
    syscall win_invalidate(win)
    return 0
}

event fn on_close() {
    return 0
}

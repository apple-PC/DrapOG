// About —— 关于本机（DrapLang 自举版，L9·D 阶段示范）
// 静态展示系统信息；背景与文字走主题语义色。
entry fn main() -> i32 {
    let win = syscall win_create("关于本机", 440, 380)
    let W = 0
    let H = 0
}

event fn on_paint() {
    W = syscall win_w()
    H = syscall win_h()
    syscall win_theme(0)
    syscall win_fill_rect(0, 0, W, H)
    syscall win_theme(1)
    syscall win_set_font(18)
    syscall win_text(18, 18, "DrapOG")
    syscall win_set_font(13)
    syscall win_text(18, 50, "版本：自举原型（DrapLang 自举操作系统）")
    syscall win_text(18, 72, "架构：DrapLang -> DrapCC -> 指令数组 -> pack -> .dbyte -> DrapVM")
    syscall win_text(18, 96, "自举层次：")
    syscall win_text(18, 118, "  L1 运行基座（浏览器 / Canvas / VFS）")
    syscall win_text(18, 138, "  L2 语言·工具（DrapCC / DrapVM / DBYTE）")
    syscall win_text(18, 158, "  L3 命令层（CMD / Shell）")
    syscall win_text(18, 178, "  L4 应用注册表（.app 格式 / launcher）")
    syscall win_text(18, 198, "  L5 图形界面（WM / Dock / AppMgr）")
    syscall win_set_font(12)
    syscall win_set_color(130, 130, 138)
    syscall win_text(18, 232, "由 DrapLang 自举的操作系统内核原型。")
    return 0
}

event fn on_close() {
    return 0
}

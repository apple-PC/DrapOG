// baseconv —— 进制转换核心（被 Conv.app 这个 GUI 应用 import 复用）
// 演示「app 调用 drapp」：gui 应用 import 兄弟 .drapp 模块的纯函数。
// 约定：只处理非负与 0；负数加 '-' 前缀。模块内只放 fn，禁止 entry/event。
import str

// 余数 → 单个数字字符（0-9 / A-F）
fn digitChar(r: i32) -> str {
  if (r < 10) { return itoa(r) }
  return charAt("ABCDEF", r - 10)
}

// 十进制整数 n → base 进制字符串（base 传 2/8/16 等）
fn toBase(n: i32, base: i32) -> str {
  if (n == 0) { return "0" }
  let neg = 0
  let x = n
  if (x < 0) { neg = 1
    x = 0 - x }
  let out = ""
  while (x > 0) {
    out = digitChar(x % base) + out
    x = x / base
  }
  if (neg == 1) { out = "-" + out }
  return out
}

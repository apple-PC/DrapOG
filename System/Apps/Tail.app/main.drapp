// tail —— 打印文件后 N 行（默认 10）
// 用法: tail <文件> [行数=10]
// 运行: run tail <文件> [行数]
import str

entry fn main() -> i32 {
  let n = syscall args_count()
  if (n < 2) {
    term_println("用法: tail <文件> [行数=10]")
    return 1
  }
  let path = syscall args_get(1)
  if (syscall fs_exists(path) == 0) {
    term_println("tail: 找不到文件: " + path)
    return 2
  }
  let limit = 10
  if (n >= 3) {
    limit = atoi(syscall args_get(2))
    if (limit <= 0) { limit = 10 }
  }
  let content = syscall fs_read(path)
  let norm = replace(content, "\r", "")
  let lines = split(norm, "\n")
  let count = lines.len
  if (count > 0) {
    let last = lines[count - 1]
    if (len(last) == 0) { count = count - 1 }
  }
  let start = count - limit
  if (start < 0) { start = 0 }
  let i = start
  while (i < count) {
    term_println(lines[i])
    i = i + 1
  }
  return 0
}

// cat —— 打印文件内容（支持 -n 行号）
// 用法: cat <文件> [-n]
// 运行: run cat <文件> [-n]
// 说明: 这是运行在 cmd 里的 drapp 程序；只做功能，不碰 GUI。
import str

entry fn main() -> i32 {
  let n = syscall args_count()
  if (n < 2) {
    term_println("用法: cat <文件> [-n]")
    return 1
  }
  let path = syscall args_get(1)
  if (syscall fs_exists(path) == 0) {
    term_println("cat: 找不到文件: " + path)
    return 2
  }
  let content = syscall fs_read(path)
  let norm = replace(content, "\r", "")
  let lines = split(norm, "\n")
  // 去掉结尾单个换行产生的空行（split("a\n")→["a",""]），避免多出一个空行
  let count = lines.len
  if (count > 0) {
    let lastIdx = count - 1
    let last = lines[lastIdx]
    if (len(last) == 0) { count = count - 1 }
  }
  let showNum = 0
  if (n >= 3) {
    let flag = syscall args_get(2)
    if (flag == "-n") { showNum = 1 }
  }
  let i = 0
  while (i < count) {
    if (showNum == 1) {
      term_print(itoa(i + 1))
      term_print("\t")
    }
    term_println(lines[i])
    i = i + 1
  }
  return 0
}

// Settings —— 系统设置（DrapLang 自举版，L9：macOS 风格改版）
// 侧栏仿 macOS 系统设置（图标色块 + 名称）；主题相关设置项统一归入「外观」模块，
// 软键盘开关在「通用」，未实现的分类显示占位说明。
// 模型：main 初始化共享状态与窗口；on_paint 自绘；on_click 处理侧栏分类与按钮。
entry fn main() -> i32 {
    let win = syscall win_create("设置", 560, 440)
    let cat = 5        // 默认落在「外观」
    let theme = 0      // 0=macOS 1=Windows（本地跟踪，切换时同步给 WM）
    let kb = 0         // 软键盘开关（本地跟踪）
    let W = 0
    let H = 0
    let labels = [""]
    let icons = [""]
    let cols = [0]
    let i = 0
    let ry = 0
    let cx = 0
    let id = ""
    let x = 0
    let y = 0
}

event fn on_paint() {
    W = syscall win_w()
    H = syscall win_h()
    // 背景与侧栏
    syscall win_theme(0)
    syscall win_fill_rect(0, 0, W, H)
    syscall win_theme(3)
    syscall win_fill_rect(0, 0, 150, H)
    // 侧栏条目（macOS 风格：彩色图标块 + 名称）
    labels = split("Wi-Fi,蓝牙,网络,电池,通用,外观,显示器,桌面与程序坞,账户,关于", ",")
    icons = split("📶,🔵,🌐,🔋,⚙,🎨,🖥,🚀,👤,ℹ", ",")
    cols = [0, 122, 255, 10, 132, 255, 52, 199, 89, 52, 199, 89, 142, 142, 147, 255, 159, 10, 0, 122, 255, 94, 92, 230, 0, 122, 255, 142, 142, 147]
    i = 0
    while (i < 10) {
        ry = 12 + i * 30
        if (i == cat) {
            syscall win_theme(4)
            syscall win_fill_rect(6, ry, 138, 26)
        }
        syscall win_set_color(cols[i * 3], cols[i * 3 + 1], cols[i * 3 + 2])
        syscall win_fill_rect(14, ry + 3, 20, 20)
        syscall win_theme(1)
        syscall win_set_font(14)
        syscall win_text(18, ry + 6, icons[i])
        syscall win_set_font(13)
        syscall win_text(44, ry + 6, labels[i])
        i = i + 1
    }
    // 内容区
    cx = 170
    if (cat == 5) {
        syscall win_theme(1)
        syscall win_set_font(20)
        syscall win_text(cx, 20, "外观")
        syscall win_set_font(12)
        syscall win_set_color(130, 130, 138)
        syscall win_text(cx, 52, "管理系统主题与界面外观偏好。")
        syscall win_theme(3)
        syscall win_stroke_rect(cx - 6, 76, W - cx - 34, 98)
        syscall win_theme(1)
        syscall win_set_font(14)
        syscall win_text(cx + 8, 90, "系统主题")
        syscall win_button("macos", cx + 150, 84, 76, 28)
        syscall win_button("windows", cx + 234, 84, 88, 28)
        syscall win_set_font(12)
        syscall win_set_color(130, 130, 138)
        if (theme == 0) { syscall win_text(cx + 8, 136, "当前：macOS（切换即时生效）") }
        else { syscall win_text(cx + 8, 136, "当前：Windows 11（切换即时生效）") }
    } else if (cat == 4) {
        syscall win_theme(1)
        syscall win_set_font(20)
        syscall win_text(cx, 20, "通用")
        syscall win_set_font(12)
        syscall win_set_color(130, 130, 138)
        syscall win_text(cx, 52, "管理整体偏好设置，例如软件更新、软键盘等。")
        syscall win_theme(3)
        syscall win_stroke_rect(cx - 6, 76, W - cx - 34, 70)
        syscall win_theme(1)
        syscall win_set_font(14)
        syscall win_text(cx + 8, 90, "移动端软键盘")
        syscall win_button("kb", cx + 180, 84, 56, 28)
        syscall win_set_font(12)
        syscall win_set_color(130, 130, 138)
        if (kb == 0) { syscall win_text(cx + 8, 124, "状态：关") }
        else { syscall win_text(cx + 8, 124, "状态：开") }
    } else if (cat == 8) {
        syscall win_theme(1)
        syscall win_set_font(20)
        syscall win_text(cx, 20, "账户")
        syscall win_set_font(16)
        syscall win_text(cx, 60, "guest")
        syscall win_set_font(13)
        syscall win_set_color(130, 130, 138)
        syscall win_text(cx, 90, "本地账户 · 管理员")
    } else if (cat == 9) {
        syscall win_theme(1)
        syscall win_set_font(20)
        syscall win_text(cx, 20, "关于")
        syscall win_set_font(14)
        syscall win_text(cx, 60, "DrapOG · 自举原型")
        syscall win_set_font(13)
        syscall win_text(cx, 88, "DrapLang → DrapCC → DrapVM")
        syscall win_set_color(130, 130, 138)
        syscall win_text(cx, 116, "版本 2.3.1（L9 · 外观改版）")
    } else {
        syscall win_theme(1)
        syscall win_set_font(20)
        syscall win_text(cx, 20, labels[cat])
        syscall win_set_font(13)
        syscall win_set_color(130, 130, 138)
        syscall win_text(cx, 60, "此设置项暂未开放。")
    }
    return 0
}

event fn on_click(ev: str) {
    id = split(ev, " ")[1]
    if (id == "macos") { syscall win_set_theme("macos"); theme = 0; syscall win_invalidate(win); return 0 }
    if (id == "windows") { syscall win_set_theme("windows"); theme = 1; syscall win_invalidate(win); return 0 }
    if (id == "kb") { kb = 1 - kb; syscall win_set_softkeyboard(kb); syscall win_invalidate(win); return 0 }
    // 否则为侧栏坐标点击
    x = atoi(split(ev, " ")[1])
    y = atoi(split(ev, " ")[2])
    if (x < 150 && y >= 12) {
        cat = (y - 12) / 30
        if (cat > 9) { cat = 9 }
        syscall win_invalidate(win)
    }
    return 0
}

event fn on_close() {
    return 0
}

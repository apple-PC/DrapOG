// Calc —— DrapLang 计算器（L5：win_gui 控件框架 + event fn 编写的 GUI 应用）
// 演示「app 调用 drapp」：本 GUI 应用 import 兄弟模块 calcutil.drapp 的 apply()。
//   on_paint  绘制背景 + 声明控件（标题 / 显示屏 / 4x4 按钮网格）
//   on_click  命中按钮注入 "click <id>"，驱动计算器状态机（左结合、整数、除零返回 0）
//   on_close  关闭窗口
// 说明：win_button 的 id 即显示文字，故按钮 id 直接用符号（7 8 9 / 4 5 6 * 1 2 3 - C 0 = +）。
import "calcutil"

entry fn main() -> i32 {
    let win = syscall win_create("计算器", 300, 344)
    let acc = 0
    let op = ""
    let cur = "0"
    let typing = 0
}

event fn on_paint() {
    syscall win_set_color(24, 26, 32)
    syscall win_fill_rect(0, 0, 300, 344)
    syscall win_label(16, 16, "DrapLang 计算器")
    // 显示屏（深色底 + 白字）
    syscall win_set_color(12, 14, 18)
    syscall win_fill_rect(16, 44, 268, 40)
    syscall win_set_color(255, 255, 255)
    syscall win_label(24, 54, cur)
    // 按钮网格 4x4（id=显示文字, x, y, w=56, h=48）
    syscall win_button("7", 16, 96, 56, 48)
    syscall win_button("8", 84, 96, 56, 48)
    syscall win_button("9", 152, 96, 56, 48)
    syscall win_button("/", 220, 96, 56, 48)
    syscall win_button("4", 16, 156, 56, 48)
    syscall win_button("5", 84, 156, 56, 48)
    syscall win_button("6", 152, 156, 56, 48)
    syscall win_button("*", 220, 156, 56, 48)
    syscall win_button("1", 16, 216, 56, 48)
    syscall win_button("2", 84, 216, 56, 48)
    syscall win_button("3", 152, 216, 56, 48)
    syscall win_button("-", 220, 216, 56, 48)
    syscall win_button("C", 16, 276, 56, 48)
    syscall win_button("0", 84, 276, 56, 48)
    syscall win_button("=", 152, 276, 56, 48)
    syscall win_button("+", 220, 276, 56, 48)
}

event fn on_click(ev: str) {
    let id = split(ev, " ")[1]
    if (id == "0") { if (typing == 0) { cur = "0" } else { cur = cur + "0" } typing = 1 }
    else if (id == "1") { if (typing == 0) { cur = "1" } else { cur = cur + "1" } typing = 1 }
    else if (id == "2") { if (typing == 0) { cur = "2" } else { cur = cur + "2" } typing = 1 }
    else if (id == "3") { if (typing == 0) { cur = "3" } else { cur = cur + "3" } typing = 1 }
    else if (id == "4") { if (typing == 0) { cur = "4" } else { cur = cur + "4" } typing = 1 }
    else if (id == "5") { if (typing == 0) { cur = "5" } else { cur = cur + "5" } typing = 1 }
    else if (id == "6") { if (typing == 0) { cur = "6" } else { cur = cur + "6" } typing = 1 }
    else if (id == "7") { if (typing == 0) { cur = "7" } else { cur = cur + "7" } typing = 1 }
    else if (id == "8") { if (typing == 0) { cur = "8" } else { cur = cur + "8" } typing = 1 }
    else if (id == "9") { if (typing == 0) { cur = "9" } else { cur = cur + "9" } typing = 1 }
    else if (id == "+") { if (op != "") { acc = apply(acc, op, atoi(cur)) } else { acc = atoi(cur) } op = "+"; typing = 0; cur = itoa(acc) }
    else if (id == "-") { if (op != "") { acc = apply(acc, op, atoi(cur)) } else { acc = atoi(cur) } op = "-"; typing = 0; cur = itoa(acc) }
    else if (id == "*") { if (op != "") { acc = apply(acc, op, atoi(cur)) } else { acc = atoi(cur) } op = "*"; typing = 0; cur = itoa(acc) }
    else if (id == "/") { if (op != "") { acc = apply(acc, op, atoi(cur)) } else { acc = atoi(cur) } op = "/"; typing = 0; cur = itoa(acc) }
    else if (id == "=") { if (op != "") { acc = apply(acc, op, atoi(cur)); op = "" } else { acc = atoi(cur) } cur = itoa(acc); typing = 0 }
    else if (id == "C") { acc = 0; op = ""; cur = "0"; typing = 0 }
    syscall win_invalidate(win)
}

event fn on_close() {
    return 0
}

// DrapApp：调色板 / 画板 —— 完全用 DrapLang 编写，只调用底层 win_* 工具自举出 GUI
// 验证：网格调色、点击格子高亮、按任意键重置、关闭窗口停机
// 这也证明 DrapLang 支持嵌套 while、乘(*)、取模(%) 等运算。
entry fn main() -> i32 {
    let win = syscall win_create("调色板 Paint", 300, 280)
    let cols = 6
    let rows = 4
    let cell = 44
    let sel = -1
    while (true) {
        let e = syscall win_get_event()
        if (e == "paint") {
            // 背景
            syscall win_set_color(20, 20, 26)
            syscall win_fill_rect(0, 0, 300, 280)
            // 画网格（嵌套 while + 乘法 + 取模）
            let r = 0
            while (r < rows) {
                let c = 0
                while (c < cols) {
                    let idx = r * cols + c
                    let rr = (idx * 37) % 200 + 40
                    let gg = (idx * 91) % 200 + 40
                    let bb = (idx * 53) % 200 + 40
                    syscall win_set_color(rr, gg, bb)
                    syscall win_fill_rect(8 + c * cell, 8 + r * cell, cell - 4, cell - 4)
                    if (idx == sel) {
                        syscall win_set_color(255, 255, 255)
                        syscall win_stroke_rect(8 + c * cell, 8 + r * cell, cell - 4, cell - 4)
                    }
                    c = c + 1
                }
                r = r + 1
            }
            // 说明
            syscall win_set_color(200, 200, 210)
            syscall win_set_font(13)
            syscall win_text(8, 8 + rows * cell + 8, "点击格子高亮 · 按键重置")
        } else if (split(e, " ")[0] == "click") {
            let toks = split(e, " ")
            let x = syscall win_atoi(toks[1])
            let y = syscall win_atoi(toks[2])
            let c = (x - 8) / cell
            let r = (y - 8) / cell
            if (c >= 0 && c < cols && r >= 0 && r < rows) {
                sel = r * cols + c
                syscall win_invalidate(win)
            }
        } else if (split(e, " ")[0] == "key") {
            sel = -1
            syscall win_invalidate(win)
        } else if (e == "close") {
            return 0
        }
    }
    return 0
}
